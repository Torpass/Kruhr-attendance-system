NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
# Local: Postgres de docker compose (pnpm db:up).
# Supabase → Connect → Transaction pooler (IPv4, puerto 6543), con TLS:
#   postgresql://postgres.<ref>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marcaje
# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800
# Solo para `pnpm db:seed` (datos de demo). La API no las lee.
SEED_SUPERADMIN_EMAIL=super@marcaje.test
SEED_SUPERADMIN_PASSWORD=cambia-esta-clave-larga
SEED_DEMO_PASSWORD=cambia-esta-clave
SEED_DEMO_PIN=1234
