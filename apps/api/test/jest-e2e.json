{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/setup-env.ts"
  ],
  "moduleNameMapper": {
    "^@marcaje/core$": "<rootDir>/../../../packages/core/src"
  },
  "globalSetup": "<rootDir>/global-setup.ts"
}
